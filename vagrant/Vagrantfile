Vagrant.configure("2") do |config|
  config.vm.box = "cloud-image/fedora-43"

  # Forward Flask port
  config.vm.network "forwarded_port", guest: 5000, host: 5000, auto_correct: true

  # VM resources
  config.vm.provider :libvirt do |libvirt|
    libvirt.memory = 2048
    libvirt.cpus = 2
  end

  config.vm.hostname = "sre-challenge"

  config.vm.provision "shell", inline: <<-SHELL
    set -eux

    # Update system
    sudo dnf update -y

    # Install Python3 and git
    sudo dnf install -y git python3 python3-pip

    # Create target folder
    mkdir -p /opt/sre-challenge
    cd /opt/sre-challenge

    # Sparse clone of only 'app/' folder
    git init
    git remote add origin https://github.com/DdeGooijer/sre-challenge.git
    git config core.sparseCheckout true
    echo "app/*" >> .git/info/sparse-checkout

    # Default branch is main
    DEFAULT_BRANCH=main
    git fetch --depth=1 origin $DEFAULT_BRANCH
    git checkout $DEFAULT_BRANCH

    # Fix ownership
    sudo chown -R vagrant:vagrant /opt/sre-challenge

    cd /opt/sre-challenge/app

    # Install dependencies if requirements.txt exists
    if [ -f requirements.txt ]; then
      pip3 install --upgrade pip
      pip3 install -r requirements.txt
    fi

    # Create systemd service
    sudo tee /etc/systemd/system/sre-challenge.service > /dev/null <<EOF
[Unit]
Description=SRE Challenge Python Flask App
After=network.target

[Service]
Type=simple
User=vagrant
WorkingDirectory=/opt/sre-challenge/app
ExecStart=/usr/bin/python3 application.py
Restart=always
Environment=SECRET_KEY=dev-key

[Install]
WantedBy=multi-user.target
EOF

    # Reload systemd and start service
    sudo systemctl daemon-reload
    sudo systemctl enable sre-challenge
    sudo systemctl restart sre-challenge

    # Optional: show status
    sudo systemctl status sre-challenge --no-pager
  SHELL
end
